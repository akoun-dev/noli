generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── 1. PROFILS (Utilisateurs) ───────────────────────────────────
model Profile {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        String   @default("USER") // USER, INSURER, ADMIN
  firstName   String?
  lastName    String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes          Quote[]
  insurerAccounts InsurerAccount[]
  customRoles     ProfileRole[]
  notifications   Notification[]
  sessions        Session[]
}

// ── 1b. SESSIONS ──────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── 2. ASSUREURS ──────────────────────────────────────────────
model Insurer {
  id           String   @id @default(cuid())
  code         String   @unique // NOLIA, SUNU, NSIA, GNA, SAHAM
  name         String
  logoUrl      String?
  contactEmail String?
  phone        String?
  website      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts       InsurerAccount[]
  offers         InsuranceOffer[]
  coverages      Coverage[]
}

// Junction: Utilisateur ↔ Assureur (rôle INSURER)
model InsurerAccount {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id])
  insurerId  String
  insurer    Insurer  @relation(fields: [insurerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([profileId, insurerId])
}

// ── 3. CATÉGORIES DE PRODUITS (Auto, Moto, etc.) ─────────────
model InsuranceCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers       InsuranceOffer[]
  quotes       Quote[]
}

// ── 4. CATÉGORIES DE GARANTIES (RC, Incendie, Vol...) ────────
model CoverageCategory {
  id           String   @id @default(cuid())
  code         String   @unique // RESPONSABILITE_CIVILE, INCENDIE, etc.
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coverages Coverage[]
}

// ── 5. GARANTIES (Coverages) ──────────────────────────────────
model Coverage {
  id             String   @id @default(cuid())
  code           String   @unique
  type           String   // RC, INCENDIE, VOL, etc.
  name           String
  description    String?
  calculationType String   @default("FIXED_AMOUNT") // FREE, FIXED_AMOUNT, VARIABLE_BASED, MATRIX_BASED
  categoryId     String?
  category       CoverageCategory? @relation(fields: [categoryId], references: [id])
  insurerId      String
  insurer        Insurer  @relation(fields: [insurerId], references: [id])
  isMandatory    Boolean  @default(false)
  isOptional     Boolean  @default(false)
  conditions     String   @default("{}") // JSON: conditions d'application
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)

  // Structured config columns (replacing flat JSON metadata for common fields)
  variableSource         String?  // NEW_VALUE | VENAL_VALUE | FISCAL_POWER
  ratePercent            Float?   // Taux en % (VARIABLE_BASED)
  conditionedByNewValue  Boolean  @default(false)
  newValueThreshold      Float?   // Seuil VN (défaut 25M FCFA)
  rateBelowThreshold     Float?   // Taux si VN ≤ seuil
  rateAboveThreshold     Float?   // Taux si VN > seuil
  fixedAmount            Float?   // Montant fixe (FIXED_AMOUNT)
  packPriceReduced       Float?   // Prix réduit en pack
  capital                Float?   // Capital (ex: Avance sur recours)
  minAmount              Float?   // Montant minimum de la prime
  maxAmount              Float?   // Montant maximum de la prime
  matrixDimension        String?  // FISCAL_POWER | FORMULA | VEHICLE_CATEGORY | etc.
  requiresGuarantee      String?  // Code garantie requise (ex: 'BDG')

  metadata       String   @default("{}") // JSON: config avancée (tarifs matrice, franchises, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tariffRules    CoverageTariffRule[]
  packageLinks   PackageCoverage[]
  quoteLines     QuoteCoverage[]
}

// ── 5b. RÈGLES DE TARIFICATION ────────────────────────────────
model CoverageTariffRule {
  id               String   @id @default(cuid())
  coverageId       String
  coverage         Coverage  @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  vehicleCategory  String?  // VP, VT, etc.
  minFiscalPower   Int?
  maxFiscalPower   Int?
  minVehicleValue  Float?
  maxVehicleValue  Float?
  fuelType         String?  // ESSENCE, DIESEL
  formulaName      String?  // Formule 1, 2, 3 (IC/IPT)
  baseRate         Float?   // Taux en %
  fixedAmount      Float?   // Montant fixe FCFA
  minAmount        Float?
  maxAmount        Float?
  conditions       String   @default("{}") // JSON
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── 6. OFFRES D'ASSURANCE ────────────────────────────────────
model InsuranceOffer {
  id             String   @id @default(cuid())
  insurerId      String
  insurer        Insurer  @relation(fields: [insurerId], references: [id])
  categoryId     String?
  category       InsuranceCategory? @relation(fields: [categoryId], references: [id])
  name           String
  description    String?
  priceMin       Int?
  priceMax       Int?
  coverageAmount Int?
  deductible     Int      @default(0)
  features       String   @default("[]") // JSON string[]
  contractType   String?  // basic, third_party_plus, all_risks
  isActive       Boolean  @default(true)
  // Vehicle eligibility fields
  fiscalPowerMin Int?
  fiscalPowerMax Int?
  fuelTypes      String   @default("[]") // JSON string[] : ["essence","diesel"]
  newValueMin    Int?
  newValueMax    Int?
  venalValueMin  Int?
  venalValueMax  Int?
  vehicleUsage   String   @default("[]") // JSON string[] : ["personnel","professionnel","taxi","autre"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes Quote[]
}

// ── 7. PACKAGES ───────────────────────────────────────────────
model InsurancePackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coverageLinks PackageCoverage[]
}

// Junction: Package ↔ Coverage
model PackageCoverage {
  id          String   @id @default(cuid())
  packageId  String
  package    InsurancePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  coverageId  String
  coverage    Coverage  @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([packageId, coverageId])
}

// ── 8. DEVIS ──────────────────────────────────────────────────
model Quote {
  id                    String   @id @default(cuid())
  reference             String   @unique
  userId                String?
  user                  Profile? @relation(fields: [userId], references: [id])
  categoryId            String?
  category              InsuranceCategory? @relation(fields: [categoryId], references: [id])
  offerId               String?
  offer                 InsuranceOffer? @relation(fields: [offerId], references: [id])
  status                String   @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  estimatedPrice        Int?
  finalPrice            Float?
  notes                 String?
  vehicleData           String   @default("{}") // JSON
  personalData          String   @default("{}") // JSON
  coverageRequirements  String   @default("{}") // JSON
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  coverageLines QuoteCoverage[]
}

// ── 9. LIGNES DE DEVIS ───────────────────────────────────────
model QuoteCoverage {
  id                     String   @id @default(cuid())
  quoteId                String
  quote                  Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  coverageId             String
  coverage               Coverage  @relation(fields: [coverageId], references: [id])
  tariffRuleId           String?
  premiumAmount          Int
  calculationParameters  String   @default("{}") // JSON
  isIncluded             Boolean  @default(true)
  isMandatory            Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@unique([quoteId, coverageId])
}

// ── 10. PARAMÈTRES SYSTÈME ───────────────────────────────────
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  category  String   @default("general") // general, email, security, notification, appearance
  label     String
  type      String   @default("text") // text, boolean, number, json, password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 11. JOURNAUX D'AUDIT ─────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  action    String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, EXPORT, SETTINGS_CHANGE, etc.
  entity    String   // Profile, Insurer, Offer, Quote, Settings, Backup, Role, etc.
  entityId  String?
  details   String   @default("{}") // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ── 12. SAUVEGARDES ──────────────────────────────────────────
model Backup {
  id          String   @id @default(cuid())
  filename    String
  fileSize    Int      @default(0)
  status      String   @default("COMPLETED") // COMPLETED, FAILED, IN_PROGRESS, SCHEDULED
  type        String   @default("MANUAL") // MANUAL, SCHEDULED, AUTO
  schedule    String?  // cron expression
  nextRun     DateTime?
  path        String?
  note        String?
  createdAt   DateTime @default(now())
}

// ── 13. NOTIFICATIONS ─────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  title     String
  message   String
  link      String?  // optional navigation link
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ── 14. RÔLES PERSONNALISÉS ──────────────────────────────────
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  profiles    ProfileRole[]
}

// ── 14. PERMISSIONS ──────────────────────────────────────────
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // settings.view, users.create, offers.delete, etc.
  name        String
  category    String   // settings, users, offers, quotes, insurers, coverages, backups, audit, roles
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

// Junction: Role ↔ Permission
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

// Junction: Profile ↔ Role (custom roles)
model ProfileRole {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, roleId])
}