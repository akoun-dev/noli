# Noli — Variables d'environnement de developpement local.
# Copier ce fichier vers .env et remplacer les valeurs sensibles.

# PostgreSQL Docker local
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5433"
POSTGRES_DB="noli"
POSTGRES_USER="noli_app"
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://noli_app:change-me@127.0.0.1:5433/noli"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="10000"
DATABASE_CONNECTION_TIMEOUT_MS="5000"

# Authentification locale
AUTH_SESSION_SECRET="replace-with-at-least-32-random-bytes"
AUTH_SESSION_TTL_DAYS="7"
AUTH_PASSWORD_RESET_TTL_MINUTES="30"

# ── Application ──────────────────────────────────────────────────────────────
# URL publique de l'app (utilisée dans les liens des emails de réinitialisation).
# EN PRODUCTION : positionner l'URL réelle, ex. https://noli.ci — sinon les liens
# retomberaient sur localhost. (À défaut, l'app dérive désormais l'origine depuis
# les en-têtes de la requête, mais il reste recommandé de fixer la valeur.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Emails (SMTP Gmail — provider principal) ────────────────────────────────
# Gmail impose que l'adresse « From » soit celle du compte authentifié (SMTP_USER).
# Pour générer SMTP_PASS : activer la validation 2 étapes sur le compte Gmail,
# puis créer un « mot de passe d'application » (16 caractères) sur
# https://myaccount.google.com/apppasswords — l'ancien mode « applications
# moins sécurisées » étant supprimé par Google.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"               # 465 (SSL implicite) ou 587 (STARTTLS)
SMTP_SECURE="true"            # true=465, false=587
SMTP_USER="ton.adresse@gmail.com"
SMTP_PASS="YOUR_GMAIL_APP_PASSWORD"
SMTP_FROM="NOLI Assurance <ton.adresse@gmail.com>"

# ── Emails (Resend — fallback) ──────────────────────────────────────────────
# Utilisé UNIQUEMENT si les variables SMTP_* ci-dessus ne sont pas renseignées.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
# Expéditeur affiché sur les emails sortants en mode Resend
# (optionnel, défaut : NOLI Assurance <devis@noli.ci>)
EMAIL_FROM="NOLI Assurance <devis@noli.ci>"

# ── Sécurité / Rate limiting ─────────────────────────────────────────────────
# Le rate limiting d'authentification (login, register, forgot) est en mémoire
# (adapté au déploiement PM2 mono-instance). Pour une montée en charge
# multi-instance ou serverless, brancher un stockage partagé :
#   UPSTASH_REDIS_REST_URL="https://...upstash.io"
#   UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ── Sauvegardes ───────────────────────────────────────────────────────────────
BACKUP_DATABASE_URL="postgresql://noli_app:change-me@127.0.0.1:5433/noli"
