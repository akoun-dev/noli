# ─────────────────────────────────────────────────────────────────────────────
# Noli — Template .env (à copier en .env et remplir)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
# URL publique du projet (ex: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Clé anon publique (client + serveur SSR)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"
# Clé service_role (côté serveur UNIQUEMENT, jamais exposée au client)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# URL publique de l'app (utilisée dans les emails de réinitialisation)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Emails (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY="YOUR_RESEND_API_KEY"
