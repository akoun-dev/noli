{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-remote:*)",
      "Bash(git show:*)",
      "Bash(bun install)",
      "Bash(bun run dev:*)",
      "Bash(bun run build)",
      "Bash(bun run start:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run test:*)",
      "Bash(bun run check:*)",
      "Bash(bunx vitest:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx knip:*)",
      "Bash(npx jscpd:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase migration:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(gh api:*)",
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git push:* origin main*)",
      "Bash(git push:* origin master*)",
      "Bash(git push --force:*)",
      "Bash(supabase db reset:*)",
      "Bash(pm2:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Bash(rm -rf /:*)",
      "Bash(git push --force origin 2.0.0:*)"
    ]
  }
}
